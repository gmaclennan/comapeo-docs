# CoMapeo Docs — environment variables

# Notion API authentication
# Generate at https://www.notion.so/profile/integrations
# Required for scripts/notion-export/ (Phase 2+)
NOTION_API_KEY=ntn_your_integration_token_here

# Notion page tree root for the documentation site
# See https://www.notion.so/CoMapeo-Docs-page-tree-360c90f22b6381b5a108c49dfb1ff9af
# Default: the production root pageId
NOTION_ROOT_PAGE_ID=360c90f22b6381b5a108c49dfb1ff9af

# Notion API version. Pinned to the version supported by the Markdown Content API.
# Do not change without consulting .claude/skills/notion-markdown-export/SKILL.md
NOTION_VERSION=2026-03-11
