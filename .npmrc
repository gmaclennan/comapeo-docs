# pnpm's flat-modules + minimum-release-age live in pnpm-workspace.yaml.
# This file mirrors min-release-age for users (or CI) who accidentally run
# `npm install` — npm 11+ honours `min-release-age` (in minutes) and refuses
# to install versions younger than this threshold.
# 4,320 minutes = 3 days.
min-release-age=4320
