{
  "name": "comapeo-docs",
  "version": "0.2.0-alpha",
  "private": true,
  "license": "MIT",
  "scripts": {
    "docusaurus": "docusaurus",
    "dev": "docusaurus start",
    "dev:es": "docusaurus start --locale es",
    "dev:pt": "docusaurus start --locale pt",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "deploy": "docusaurus deploy",
    "lint": "eslint src --ext .js,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.ts,.tsx --fix",
    "typecheck": "tsc --noEmit",
    "notion:walk": "node --env-file-if-exists=.env scripts/notion-export/walk-tree.ts",
    "notion:export": "node --env-file-if-exists=.env scripts/notion-export/index.ts",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage --pool=threads",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/faster": "^3.10.1",
    "@docusaurus/plugin-pwa": "^3.10.1",
    "@docusaurus/plugin-sitemap": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@mdx-js/react": "^3.1.1",
    "@sindresorhus/slugify": "^3.0.0",
    "clsx": "^2.1.1",
    "fetch-extras": "^3.0.1",
    "node-html-parser": "^7.1.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@docusaurus/eslint-plugin": "^3.10.1",
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0"
  }
}
